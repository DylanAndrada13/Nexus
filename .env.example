# Copia este archivo como .env y completa los valores

# Base de datos
# Para desarrollo local (SQLite):
DATABASE_URL="file:./dev.db"
# Para producción en Vercel (PostgreSQL recomendado):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# URL pública de tu app
APP_URL="http://localhost:3000"

# Clave secreta para las sesiones (mínimo 32 caracteres, generada con crypto.randomBytes)
SESSION_SECRET="cambia-esto-por-una-clave-secreta-de-al-menos-32-caracteres"

# Resend (email transaccional) — opcional
RESEND_API_KEY=""
EMAIL_FROM="NEXUS FF <no-reply@nexusff.com>"

# Solo en desarrollo: mostrar link de reset en consola en vez de enviar email
# DEV_SHOW_RESET_LINK=true
